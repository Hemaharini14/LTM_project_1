# Copy to .env and fill in. Never commit .env. None of these reach the browser.

SECRET_KEY=change-me                 # Flask session signing key (generate: python -c "import secrets;print(secrets.token_hex(32))")

# --- Live flights (Aviationstack). Free plan: ~100 calls/month.
AVIATIONSTACK_API_KEY=your_key_here
AVIATIONSTACK_MONTHLY_CAP=90         # app refuses past this, to keep headroom under the plan's 100
FLIGHT_SEARCH_CACHE_TTL_S=300        # reuse an identical live search for this many seconds (60-300 suggested)

# --- Weather. The delay model's weather comes from Open-Meteo, which needs NO key.
# WeatherAPI.com is a separate, optional live-conditions source:
WEATHERAPI_KEY=your_key_here
WEATHERAPI_MONTHLY_CAP=900

# --- Optional fares (Google Flights via SerpApi) - shown in flight details only
SERPAPI_KEY=your_key_here
SERPAPI_MONTHLY_CAP=90

# --- Optional
GEOAPIFY_API_KEY=
FOURSQUARE_API_KEY=
ADMIN_EMAILS=you@example.com
