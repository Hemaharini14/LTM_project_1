# Copy this file to ".env" (same folder) and fill in your own key.
# ".env" is already in .gitignore - it will never be committed.

# Powers three things:
#   1. The final narration step on both the delay-recovery plan and the
#      budget trip plan (recovery_graph.py / trip_planner.py via llm_utils.py)
#   2. The sidebar chatbot's reasoning agent (chat_agent.py)
#   3. AI-suggested food spots/sightseeing for destinations with no curated
#      entry in intl_reference.py (always labeled "unverified" in the UI)
# Without these set, all three fall back to deterministic template text / a
# "not configured" message - the rest of the app still works fully.
#
# Pick ONE provider below and fill in that key - langchain-openai and
# langchain-anthropic are already installed; Grok needs no extra package
# either (its API is OpenAI-compatible, reused via ChatOpenAI + base_url).

# --- Option A: OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Option B: Anthropic (Claude) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Option C: xAI (Grok) ---
LLM_PROVIDER=grok
GROK_API_KEY=gsk_your-key-here
GROK_MODEL=grok-4

# Flask session signing key - set this to any random string for real use.
SECRET_KEY=change-me-to-a-random-string

# Comma-separated list of emails that get admin access on signup/login.
ADMIN_EMAILS=aihemaharini@gmail.com
