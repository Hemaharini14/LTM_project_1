# Python virtual environment
flight/
venv/
env/

# Python bytecode cache
__pycache__/
*.pyc

# Raw & processed datasets (large; document sources in README instead)
dataset/
outputs/

# Trained model artifacts (regenerate via src/train_delay_model_v2.py)
models/artifacts/
# Pre-retrain snapshots kept on disk for rollback/comparison; derived, never committed
models/artifacts_backup/
models/artifacts_pre_bts/
models/artifacts_bts/
models/artifacts_bts_v2/

# SQLite database (plus WAL-mode side files - see src/db.py)
*.db
*.db-shm
*.db-wal

# Environment variables / API keys — NEVER commit these
.env
.env.example

# OS junk
.DS_Store
Thumbs.db
# Showcase frontend (web/) - source is tracked, build output is not.
# Rebuild with: cd web && npm install && npm run build
web/node_modules/
static/showcase/

# Cached AviationStack responses and the monthly call tally - machine-local
# state, and the cache can hold a lot of flight rows.
data/cache/
data/aviationstack_usage.json
data/serpapi_usage.json
data/weatherapi_usage.json
